generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  name               String
  accountType        AccountType @default(USER)
  avatarUrl          String?
  isEmailVerified    Boolean   @default(false)
  isBanned           Boolean   @default(false)
  emailVerifyToken   String?
  resetPasswordToken String?
  resetTokenExpires  DateTime?
  username           String?   @unique
  bio                String?
  city               String?
  country            String?
  district           String?
  onboardingCompleted Boolean  @default(false)
  accountSubtype     String?   @default("COLLECTOR")
  notifyOnMessage    Boolean   @default(true)
  notifyOnFavorite   Boolean   @default(true)
  createdAt          DateTime  @default(now())
  lastLoginAt        DateTime?
  updatedAt          DateTime  @updatedAt

  artistProfile  ArtistProfile?
  favorites      Favorite[]
  collections    Collection[]
  following      Follow[]      @relation("Follower")
  contactsSent   ContactRequest[] @relation("SenderContacts")
  notifications         Notification[]
  conversations         ConversationParticipant[]
  sentMessages          Message[]         @relation("SentMessages")
  readMessages          MessageRead[]     @relation("ReadMessages")
  reportedConversations Conversation[]    @relation("ReportedConversations")
  orders                Order[]           @relation("BuyerOrders")
  posts                 Post[]
  artworkComments       ArtworkComment[]  @relation("ArtworkComments")
  artworkLikes          ArtworkLike[]     @relation("ArtworkLikes")
  postComments          PostComment[]     @relation("PostComments")
  userFollowing         UserFollow[]      @relation("UserFollower")
  userFollowers         UserFollow[]      @relation("UserFollowing")
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("UserFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model ArtistProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistName     String
  username       String   @unique
  bio            String?
  coverImageUrl  String?
  city           String?
  country        String?
  contactEmail   String?
  phone          String?
  websiteUrl     String?
  instagramUrl   String?
  behanceUrl     String?
  linkedinUrl    String?
  isFeatured     Boolean  @default(false)
  isApproved     Boolean  @default(false)
  status         ArtistStatus @default(DRAFT)
  adminNotes       String?
  stripeAccountId  String?
  stripeOnboarded  Boolean @default(false)
  district          String?
  createdAt      DateTime @default(now())

  artworks         Artwork[]
  categories       ArtistCategory[]
  contactsReceived ContactRequest[] @relation("ArtistContacts")
  followers        Follow[]
  posts            ArtistPost[]
  collections      ArtistCollection[]
  orders           Order[]
  curatedItems     CuratedItem[]    @relation("CuratedArtists")
}


model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?
  iconUrl     String?

  artworks ArtworkCategory[]
  artists  ArtistCategory[]
}

model ArtistCategory {
  artistId   String
  categoryId String
  artist     ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  category   Category      @relation(fields: [categoryId], references: [id])

  @@id([artistId, categoryId])
}

model Artwork {
  id             String       @id @default(uuid())
  artistId       String
  artist         ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  technique      String?
  dimensions     String?
  yearCreated    Int?
  price          Decimal?     @db.Decimal(10, 2)
  priceOnRequest Boolean      @default(false)
  availability   Availability @default(AVAILABLE)
  isFeatured       Boolean      @default(false)
  isDraft          Boolean      @default(false)
  commissionPercent     Decimal?  @default(5)
  stock                 Int?      @default(1)
  collectionId     String?
  collection       ArtistCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  conversations    Conversation[]
  orders           Order[]
  shipping         ArtworkShipping?
  comments         ArtworkComment[]
  likes            ArtworkLike[]
  curatedItems     CuratedItem[]    @relation("CuratedArtworks")
  isApproved     Boolean      @default(true)
  viewCount      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  images     ArtworkImage[]
  categories ArtworkCategory[]
  favorites     Favorite[]
  collectionItems CollectionItem[]
  contacts   ContactRequest[]
}

model ArtworkImage {
  id           String  @id @default(uuid())
  artworkId    String
  artwork      Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  imageUrl     String
  isPrimary    Boolean @default(false)
  displayOrder Int     @default(0)
}

model ArtworkCategory {
  artworkId  String
  categoryId String
  artwork    Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([artworkId, categoryId])
}

model SiteContent {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String?
  content   String
  imageUrl  String?
  updatedAt DateTime @updatedAt
}

model ArtistPost {
  id          String        @id @default(uuid())
  artistId    String
  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title       String
  content     String
  imageUrl    String?
  published   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  artistId    String
  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, artistId])
}

model Collection {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  items       CollectionItem[]
}

model CollectionItem {
  id           String     @id @default(uuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  artworkId    String
  artwork      Artwork    @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([collectionId, artworkId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  artworkId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, artworkId])
}

model ContactRequest {
  id           String   @id @default(uuid())
  senderUserId String?
  sender       User?    @relation("SenderContacts", fields: [senderUserId], references: [id])
  artistId     String
  artist       ArtistProfile @relation("ArtistContacts", fields: [artistId], references: [id], onDelete: Cascade)
  artworkId    String?
  artwork      Artwork? @relation(fields: [artworkId], references: [id])
  name         String
  email        String
  message      String
  createdAt    DateTime @default(now())
}

enum AccountType {
  USER
  ARTIST
  ADMIN
}

enum Availability {
  AVAILABLE
  SOLD
  RESERVED
}

model Conversation {
  id                  String    @id @default(uuid())
  artworkId           String?
  artwork             Artwork?  @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  status              String    @default("OPEN")
  canBuyerReply       Boolean   @default(true)
  canArtistReply      Boolean   @default(true)
  lastMessageAt       DateTime?
  lastMessagePreview  String?
  reportedAt          DateTime?
  reportedBy          String?
  reportedByUser      User?     @relation("ReportedConversations", fields: [reportedBy], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  participants        ConversationParticipant[]
  messages            Message[]
  shipments           Shipment[]
  orders              Order[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("BUYER")
  unreadCount    Int          @default(0)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  type           String       @default("TEXT")
  imageUrl       String?
  metadata       String?
  createdAt      DateTime     @default(now())
  reads          MessageRead[]
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ReadMessages", fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
}

model Shipment {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime     @default(now())
}

model Order {
  id                    String   @id @default(uuid())
  buyerId               String
  buyer                 User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  artistId              String
  artist                ArtistProfile @relation(fields: [artistId], references: [id])
  artworkId             String
  artwork               Artwork  @relation(fields: [artworkId], references: [id])
  conversationId        String?
  conversation          Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status                String   @default("PENDING")
  fulfillmentStatus     String   @default("PAID")
  amount                Decimal
  platformFee           Decimal
  artistAmount          Decimal
  currency              String   @default("eur")
  stripePaymentIntentId String?
  stripeTransferId      String?
  shippingAddress       String?
  trackingNumber        String?
  trackingUrl           String?
  notes                 String?
  paidAt                DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ArtworkShipping {
  id            String   @id @default(uuid())
  artworkId     String   @unique
  artwork       Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  freeShipping  Boolean  @default(false)
  portugal      Decimal?
  europe        Decimal?
  world         Decimal?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Post {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  imageUrl  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comments  PostComment[]
}

model ArtworkComment {
  id        String   @id @default(uuid())
  artworkId String
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ArtworkComments", fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model ArtworkLike {
  id        String   @id @default(uuid())
  artworkId String
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ArtworkLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([artworkId, userId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("PostComments", fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model CuratedCollection {
  id           String        @id @default(uuid())
  title        String
  description  String?
  coverImageUrl String?
  slug         String        @unique
  published    Boolean       @default(false)
  position     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  items        CuratedItem[]
}

model CuratedItem {
  id           String            @id @default(uuid())
  collectionId String
  collection   CuratedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  artworkId    String?
  artwork      Artwork?          @relation("CuratedArtworks", fields: [artworkId], references: [id], onDelete: Cascade)
  artistId     String?
  artist       ArtistProfile?    @relation("CuratedArtists", fields: [artistId], references: [id], onDelete: Cascade)
  position     Int               @default(0)
  createdAt    DateTime          @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum ArtistStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

model ArtistCollection {
  id          String   @id @default(uuid())
  artistId    String
  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  name        String
  description String?
  coverImageUrl String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  artworks    Artwork[]
}
